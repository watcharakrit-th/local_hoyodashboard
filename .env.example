# HoYoLAB session cookie values. Log into hoyolab.com, open devtools > Application > Cookies
# and copy ltuid_v2 / ltoken_v2. These are long-lived session tokens - treat them like a password.
HOYOLAB_LTUID=
HOYOLAB_LTOKEN=

# Genshin Impact role UID + server region (os_usa | os_euro | os_asia | os_cht)
GENSHIN_UID=
GENSHIN_SERVER=os_asia

# Honkai: Star Rail role UID + server region (prod_official_usa | prod_official_eur | prod_official_asia | prod_official_cht)
HSR_UID=
HSR_SERVER=prod_official_asia

# Zenless Zone Zero role UID + server region (prod_gf_us | prod_gf_eu | prod_gf_jp | prod_gf_sg)
ZZZ_UID=
ZZZ_SERVER=prod_gf_jp

# Wuthering Waves account email/password (the game client login, not KuroBBS
# website login — no Chinese phone number needed). Treat like a password.
WUWA_EMAIL=
WUWA_PASSWORD=

# A stable, one-time-generated device ID for the above account (any UUIDv4,
# uppercase). Generate once with:
#   node -e "console.log(require('crypto').randomUUID().toUpperCase())"
# and never change it — Kuro's login re-uses this to recognize the same
# device each time instead of looking like a brand-new device on every
# request, which matters for account-safety (see src/lib/kurobbs/wuwa.ts).
WUWA_DEVICE_ID=

# Arknights: Endfield — SKPORT (Gryphline's community site) session
# credential. Log into https://www.skport.com with your Gryphline account,
# open devtools > Application > Cookies, and copy the SK_OAUTH_CRED_KEY
# cookie's value. Long-lived like HOYOLAB_LTOKEN above — treat it like a
# password. There's no email/password variable for this one on purpose:
# see src/lib/skport/endfield.ts for why.
SKPORT_CRED=
